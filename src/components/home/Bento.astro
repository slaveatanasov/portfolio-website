---
import Tile from '../Tile.astro';
import Chips from '../Chips.astro';
import ToptalBadge from '../ToptalBadge.astro';
import { facts, coreStack } from '../../data/profile';

const [availability, location, rightToWork] = facts;
---

<section class="container-site" aria-label="At a glance">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-12">
    <Tile class="sm:col-span-2 lg:col-span-7 flex flex-col justify-between gap-8">
      <p class="label">{availability.label}</p>
      <div>
        <p class="text-xl leading-snug font-medium text-fg sm:text-2xl">
          {availability.value}
        </p>
        <p class="mt-3 text-sm text-fg-muted">
          Contract, fractional or project-based. Embedded in your team or delivering end to end.
        </p>
      </div>
    </Tile>

    <Tile class="lg:col-span-5 flex items-center justify-center" padded={false}>
      <div class="scale-[0.9] py-4 sm:scale-100">
        <ToptalBadge />
      </div>
    </Tile>

    {
      [location, rightToWork].map((f) => (
        <Tile class="lg:col-span-4 flex flex-col justify-between gap-6">
          <p class="label">{f.label}</p>
          <div>
            <p class="text-base leading-snug font-medium text-fg">{f.value}</p>
            <p class="mt-2 text-sm text-fg-muted">{f.note}</p>
          </div>
        </Tile>
      ))
    }

    <Tile class="sm:col-span-2 lg:col-span-4 flex flex-col justify-between gap-6">
      <p class="label">Tech stack</p>
      <Chips items={coreStack} />
    </Tile>
  </div>
</section>
