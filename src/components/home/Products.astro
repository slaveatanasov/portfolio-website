---
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';

const featured = (await getCollection('projects', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="projects" class="container-site scroll-mt-20" aria-labelledby="projects-label">
  <SectionHeading id="projects" label="Projects" title="Client builds and my own products, end to end">
    <a slot="aside" href="/projects" class="font-mono text-xs text-fg-muted no-underline hover:text-fg">
      All projects &rarr;
    </a>
  </SectionHeading>

  <div class="grid gap-4 lg:grid-cols-2">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
