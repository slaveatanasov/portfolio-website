---
const isHome = Astro.url.pathname === '/';
const links = [
  { href: isHome ? '#work' : '/#work', label: 'Work' },
  { href: '/projects', label: 'Projects', wide: true },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<!-- Fully clear at the top. Blur, tint and border ramp in over the first 100px of scroll. -->
<header class="site-header sticky top-0 z-50 border-b">
  <div class="header-frost" aria-hidden="true"></div>
  <div class="container-site relative z-10 flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="brand-sa font-display text-[1.75rem] leading-none font-black tracking-[-0.02em] no-underline"
      aria-label="Slave Atanasov, home"
    >
      SA
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-5 text-sm sm:gap-7">
        {
          links.map(({ href, label, wide }) => {
            const active = !href.startsWith('#') && current.startsWith(href);
            return (
              <li class:list={[wide && 'hidden sm:block']}>
                <a
                  href={href}
                  class:list={[
                    'font-mono text-[0.8125rem] tracking-wide no-underline transition-colors',
                    active ? 'text-fg' : 'text-fg-muted hover:text-fg',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Outlined SA, never filled: muted at rest, lighter on hover. */
  .brand-sa {
    color: transparent;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 1.25px rgb(232 234 238 / 0.45);
    transition: -webkit-text-stroke-color 200ms ease;
  }
  .brand-sa:hover,
  .brand-sa:focus-visible {
    color: transparent;
    -webkit-text-stroke-color: rgb(255 255 255 / 0.95);
  }
  .site-header {
    --hdr: 0;
    border-bottom-color: rgb(22 25 30 / calc(0.8 * var(--hdr)));
    transition: border-color 450ms ease;
  }
  /* The frost is a separate layer so the blur is not flattened away by the
     header background. Both values are written from the scroll script: the CSS
     build drops unprefixed backdrop-filter, and a variable inside blur() does
     not repaint. */
  .header-frost {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
</style>

<script>
  const RAMP = 100;
  const header = document.querySelector<HTMLElement>('.site-header');
  const frost = header?.querySelector<HTMLElement>('.header-frost');
  if (header && frost) {
    let queued = false;
    const sync = () => {
      queued = false;
      const t = Math.min(Math.max(window.scrollY / RAMP, 0), 1);
      header.style.setProperty('--hdr', t.toFixed(3));
      frost.style.backgroundColor = `rgb(6 7 8 / ${(0.62 * t).toFixed(3)})`;
      const blur = t === 0 ? 'none' : `blur(${(22 * t).toFixed(2)}px)`;
      frost.style.setProperty('backdrop-filter', blur);
      frost.style.setProperty('-webkit-backdrop-filter', blur);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(sync);
        }
      },
      { passive: true },
    );
    sync();
  }
</script>
