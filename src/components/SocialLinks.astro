---
import { site } from '../data/site';

interface Props {
  size?: 'sm' | 'lg';
  class?: string;
  hideEmail?: boolean;
  /** `hero` sits on the aurora: darker fill, brighter edge. */
  tone?: 'default' | 'hero';
}

const { size = 'sm', class: className, hideEmail = false, tone = 'default' } = Astro.props;
const icon = size === 'lg' ? 'size-5' : 'size-[1.125rem]';
const pad = size === 'lg' ? 'size-11' : 'size-9';
// `key` is the borderless physical-button style from global.css.
const toneClass =
  tone === 'hero'
    ? 'key'
    : 'border border-border text-fg-muted no-underline transition-colors duration-150 hover:border-border-strong hover:bg-bg-raised hover:text-fg';

const items = [
  { href: site.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: site.github, label: 'GitHub', icon: 'github' },
  ...(!hideEmail
    ? [{ href: `mailto:${site.email}`, label: 'Email', icon: 'email' as const }]
    : []),
];
---

<ul class:list={['flex items-center gap-2', className]}>
  {
    items.map(({ href, label, icon: name }) => (
      <li>
        <a
          href={href}
          target={href.startsWith('mailto') ? undefined : '_blank'}
          rel={href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
          aria-label={label}
          title={label}
          class:list={[
            pad,
            toneClass,
            'inline-flex items-center justify-center rounded-lg',
          ]}
        >
          {name === 'linkedin' && (
            <svg class={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
            </svg>
          )}
          {name === 'github' && (
            <svg class={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.72.09-.72 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0C17.3 4.8 18.3 5.1 18.3 5.1c.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.38.81 1.1.81 2.23l-.01 3.3c0 .32.22.7.84.58A12 12 0 0 0 12 .3Z" />
            </svg>
          )}
          {name === 'email' && (
            <svg
              class={icon}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>
