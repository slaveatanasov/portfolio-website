---
interface Props {
  items: readonly string[];
  class?: string;
  size?: 'xs' | 'sm';
}

const { items, class: className, size = 'xs' } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-1.5', className]} aria-label="Stack">
  {
    items.map((item) => (
      <li
        class:list={[
          'rounded-md border border-border bg-bg px-2 py-0.5 font-mono text-fg-muted',
          size === 'xs' ? 'text-[0.6875rem]' : 'text-xs',
        ]}
      >
        {item}
      </li>
    ))
  }
</ul>
