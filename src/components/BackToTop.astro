---
/**
 * Back-to-top key, bottom right. Appears after scrolling past one screen, and only on
 * pages long enough to need it (over ~2.5 screens tall).
 */
---

<button type="button" class="back-to-top key size-11 rounded-full" aria-label="Back to top" data-visible="false">
  <svg class="mx-auto size-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5" />
    <path d="m5 12 7-7 7 7" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    /* Same inset on both sides so it sits evenly in from the corner. */
    right: max(24px, env(safe-area-inset-right));
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 40;
    cursor: pointer;
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
    transition:
      opacity 260ms ease,
      translate 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 90ms ease-out,
      box-shadow 90ms ease-out;
  }
  .back-to-top[data-visible='true'] {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }
  @media (min-width: 640px) {
    .back-to-top {
      right: 40px;
      bottom: 40px;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.back-to-top');
  if (btn) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let queued = false;
    const sync = () => {
      queued = false;
      const vh = window.innerHeight;
      const long = document.documentElement.scrollHeight > vh * 2.5;
      btn.dataset.visible = String(long && window.scrollY > vh);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(sync);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
      // Move focus to the top so keyboard users continue from there.
      document.querySelector<HTMLElement>('header a')?.focus({ preventScroll: true });
    });
    sync();
  }
</script>
