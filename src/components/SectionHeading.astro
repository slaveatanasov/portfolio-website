---
interface Props {
  label: string;
  title: string;
  id?: string;
  class?: string;
}

const { label, title, id, class: className } = Astro.props;
---

<div class:list={['mb-8 flex flex-wrap items-end justify-between gap-4', className]} data-reveal>
  <div>
    <p class="label mb-3" id={id ? `${id}-label` : undefined}>{label}</p>
    <h2 class="text-2xl font-semibold tracking-tight text-fg sm:text-3xl">{title}</h2>
  </div>
  <slot name="aside" />
</div>
