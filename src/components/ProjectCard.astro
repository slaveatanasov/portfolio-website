---
/** Featured project tile linking to its case study. Used on the home section and /projects. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Tile from './Tile.astro';
import Frame from './Frame.astro';
import Chips from './Chips.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { id, data } = Astro.props.project;
---

<Tile
  as="a"
  href={`/work/${id}`}
  class="group flex flex-col gap-6"
  aria-label={`${data.title} case study`}
>
  {
    data.cover && (
      <Frame caption={data.title.toLowerCase().replace(/\s+/g, '')}>
        <Image
          src={data.cover}
          alt={data.coverAlt ?? data.title}
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 34rem, 100vw"
          class="aspect-[16/10] object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </Frame>
    )
  }
  <div class="flex flex-col gap-3">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-xl font-semibold text-fg">{data.title}</h3>
        <p class="mt-1 text-sm text-fg-muted">{data.tagline}</p>
      </div>
      <span class="shrink-0 font-mono text-xs text-fg-faint transition-colors group-hover:text-fg">
        Case study &rarr;
      </span>
    </div>
    <p class="text-sm leading-relaxed text-fg-muted">{data.summary}</p>
    <Chips items={data.stack} class="mt-1" />
  </div>
</Tile>
