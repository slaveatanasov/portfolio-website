---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Bento from '../components/home/Bento.astro';
import ClientWork from '../components/home/ClientWork.astro';
import Products from '../components/home/Products.astro';
import HowIWork from '../components/home/HowIWork.astro';
import { site } from '../data/site';
---

<Base title={`${site.name} — ${site.title}`} description={site.description}>
  <Hero />
  <div class="flex flex-col gap-24 sm:gap-32">
    <Bento />
    <ClientWork />
    <Products />
    <HowIWork />
  </div>
</Base>
